{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://novo-serveless-conteudo.vercel.app/:path*"
    },
    {
      "source": "/corretor-api/:path*",
      "destination": "https://corretor-back.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
